# Contact form (Resend) — the form returns 503 until all three are set.
# CONTACT_FROM_EMAIL needs orangecatmedia.dev verified in Resend; until then use onboarding@resend.dev.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@orangecatmedia.dev
CONTACT_FROM_EMAIL=Orange Cat Media <website@orangecatmedia.dev>

# Optional: overrides https://orangecatmedia.dev in canonical and Open Graph tags (e.g. for staging).
NEXT_PUBLIC_SITE_URL=
